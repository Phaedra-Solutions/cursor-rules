# npm supply-chain settings. Copy to the project root as .npmrc.
# Source: Phaedra-Solutions/cursor-rules templates/package-managers.
# Older npm versions warn about settings they don't know and ignore them.

# Only install versions published at least 7 days ago. npm >= 11.10.0; value in days.
min-release-age=7

# npm >= 12 blocks dependency install scripts by default. Approve the ones you
# need with `npm install-scripts approve <pkg>` (stored in package.json
# "allowScripts"); this makes any unreviewed script fail the install. npm >= 12.
strict-allow-scripts=true

# npm 11 and older run dependency install scripts by default. If you can't move
# to npm 12, uncomment this and run needed builds explicitly (`npm rebuild <pkg>`).
# It also skips the project's own pre/post install scripts.
# ignore-scripts=true
